{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--caps=vision"]
    },
    "dbt": {
      "command": "uvx",
      "args": ["dbt-mcp"],
      "env": {
        "DBT_PROJECT_DIR": "./dbt_project",
        "DBT_PATH": "./.venv/bin/dbt",
        "DBT_PROFILES_DIR": "~/.dbt"
      }
    }
  }
}
