{
  "$schema": "https://claude.ai/schemas/mcp-servers.json",
  "_documentation": {
    "description": "MCP Server configurations for the Japanese Learning Website project",
    "note": "This file documents recommended MCP servers for future installation. Not all servers need to be active simultaneously.",
    "warning": "Keep under 10 active MCPs per project to avoid context window issues. Fewer than 80 active tools globally.",
    "installation": "Install servers using: npx -y @anthropic-ai/mcp-cli install <server-name>"
  },

  "recommended_servers": {
    "github": {
      "purpose": "PR and issue management",
      "priority": "high",
      "current_alternative": "gh CLI via Bash tool",
      "when_to_install": "When needing advanced GitHub operations beyond gh CLI",
      "capabilities": [
        "Create and manage pull requests",
        "Work with issues",
        "Review code changes",
        "Manage repository settings"
      ],
      "install_command": "npx -y @anthropic-ai/mcp-cli install github"
    },

    "memory": {
      "purpose": "Session persistence for learning progress",
      "priority": "medium",
      "when_to_install": "When implementing user progress tracking",
      "capabilities": [
        "Persist user preferences across sessions",
        "Store learning progress",
        "Remember context between conversations"
      ],
      "note": "Useful for tracking JLPT level, completed lessons, flashcard progress",
      "install_command": "npx -y @anthropic-ai/mcp-cli install memory"
    },

    "context7": {
      "purpose": "Live documentation for APIs and libraries",
      "priority": "medium",
      "when_to_install": "When integrating external libraries or APIs",
      "capabilities": [
        "Fetch up-to-date library documentation",
        "Get API references",
        "Access current syntax and examples"
      ],
      "usage": "Add 'use context7' to prompts when researching",
      "install_command": "npx -y @anthropic-ai/mcp-cli install context7"
    },

    "filesystem": {
      "purpose": "Enhanced file operations",
      "priority": "low",
      "current_alternative": "Built-in Read, Write, Edit, Glob tools",
      "when_to_install": "When needing advanced file system operations",
      "capabilities": [
        "Complex file operations",
        "Directory management",
        "File watching"
      ],
      "install_command": "npx -y @anthropic-ai/mcp-cli install filesystem"
    },

    "greptile-mcp": {
      "purpose": "Natural language codebase queries",
      "priority": "medium",
      "when_to_install": "When codebase grows significantly",
      "capabilities": [
        "Ask questions about codebase in natural language",
        "Understand code relationships",
        "Find patterns and dependencies"
      ],
      "requires": "Greptile account and API key",
      "install_command": "npx -y @anthropic-ai/mcp-cli install greptile-mcp"
    }
  },

  "project_specific_servers": {
    "japanese_dictionary": {
      "purpose": "Japanese language reference",
      "priority": "high",
      "when_to_install": "When building vocabulary features",
      "capabilities": [
        "Look up kanji readings",
        "Get word definitions",
        "Find example sentences",
        "JLPT level verification"
      ],
      "note": "Consider jisho API or similar",
      "status": "research_needed"
    },

    "audio_generation": {
      "purpose": "Japanese pronunciation audio",
      "priority": "medium",
      "when_to_install": "When adding audio to vocabulary",
      "capabilities": [
        "Generate pronunciation audio",
        "Text-to-speech for Japanese",
        "Natural voice synthesis"
      ],
      "note": "Consider Google TTS or Azure Speech Services",
      "status": "research_needed"
    }
  },

  "context_window_considerations": {
    "warning": "Your 200k context window can shrink to 70k with too many tools enabled",
    "recommendations": [
      "Keep under 10 MCPs active per project",
      "Fewer than 80 active tools globally",
      "Load tools conditionally based on task type",
      "Use skills to encapsulate multi-step workflows"
    ],
    "monitoring": "Watch for context window warnings in Claude responses"
  },

  "installation_guide": {
    "steps": [
      "1. Identify needed MCP server from this list",
      "2. Run install command in terminal",
      "3. Configure any required API keys",
      "4. Add to active configuration",
      "5. Test functionality",
      "6. Monitor context window impact"
    ],
    "config_location": "~/.claude/claude_mcp_config.json",
    "per_project_config": ".claude/mcp-config.json"
  },

  "current_project_status": {
    "active_mcps": [],
    "using_alternatives": [
      {
        "for": "GitHub operations",
        "using": "gh CLI via Bash tool"
      }
    ],
    "planned_installations": [
      "japanese_dictionary (when vocabulary features expand)",
      "memory (when progress tracking implemented)"
    ]
  }
}
