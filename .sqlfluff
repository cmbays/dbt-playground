[sqlfluff]
# Use DuckDB dialect for this project
dialect = duckdb
templater = dbt
# Be less verbose for CI
verbose = 0
nocolor = True
# Line length - increased to 150 for dbt_utils macro calls
max_line_length = 150

# Exclude rules that don't fit our staging model patterns:
# - CP02: We reference UPPERCASE source columns and rename to lowercase
# - AL09: We intentionally alias columns for clarity in transformations
# - LT02: Indentation rules conflict with our 4-space CTE style
# - LT04: Leading comma rule conflicts with CTE trailing separators
# - ST06: Column order rule conflicts with our comment-organized sections
exclude_rules = capitalisation.identifiers, aliasing.self_alias.column, layout.indent, layout.commas, structure.column_order

[sqlfluff:templater:dbt]
project_dir = dbt_project
profiles_dir = ~/.dbt

[sqlfluff:indentation]
indented_joins = True
indented_ctes = True
indented_using_on = True
# 4-space indentation per coding standards
tab_space_size = 4
indent_unit = space
# Don't enforce nested indentation within CTEs
indented_on_contents = False

[sqlfluff:rules]
# Allow implicit aliases in select
allow_scalar = True

# Capitalize SQL keywords consistently (lowercase per our style guide)
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

# Capitalize function names consistently
[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

# Capitalize literals consistently
[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

# Capitalize types consistently
[sqlfluff:rules:capitalisation.types]
capitalisation_policy = lower

# Use leading commas (per project coding standards)
# See: https://docs.sqlfluff.com/en/latest/configuration/layout.html
[sqlfluff:layout:type:comma]
spacing_before = touch
line_position = leading

# Aliasing preferences
[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

# Allow CTEs to use column aliases
[sqlfluff:rules:references.consistent]
single_table_references = consistent

