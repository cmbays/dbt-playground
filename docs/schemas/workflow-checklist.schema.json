{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dbt-playground/schemas/workflow-checklist.schema.json",
  "title": "WorkflowChecklist",
  "description": "Per-ticket workflow checklist tracking stage progression (v1.0)",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version for forward compatibility"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]+$",
      "description": "Reference to Backlog.md task ID"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When checklist was initialized"
    },
    "stages": {
      "type": "object",
      "properties": {
        "understand": { "$ref": "#/definitions/StageChecklist" },
        "plan": { "$ref": "#/definitions/StageChecklist" },
        "build": { "$ref": "#/definitions/StageChecklist" },
        "verify": { "$ref": "#/definitions/StageChecklist" },
        "deploy": { "$ref": "#/definitions/StageChecklist" }
      },
      "required": ["understand", "plan", "build", "verify", "deploy"],
      "additionalProperties": false
    },
    "compliance": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Calculated compliance score"
        },
        "skips": {
          "type": "array",
          "items": { "$ref": "#/definitions/SkipRecord" },
          "description": "History of skipped stages"
        },
        "bypasses": {
          "type": "array",
          "items": { "$ref": "#/definitions/BypassRecord" },
          "description": "History of authorized bypasses"
        }
      },
      "required": ["score", "skips", "bypasses"]
    }
  },
  "required": ["version", "task_id", "created_at", "stages", "compliance"],
  "definitions": {
    "StageChecklist": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "complete", "skipped"],
          "description": "Current status of this stage"
        },
        "required_items": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Items required to complete this stage"
        },
        "completed_items": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Items already completed"
        },
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When work on this stage began"
        },
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When this stage was completed"
        },
        "agent": {
          "type": ["string", "null"],
          "description": "Agent that worked on this stage"
        }
      },
      "required": ["status", "required_items", "completed_items"],
      "additionalProperties": false
    },
    "SkipRecord": {
      "type": "object",
      "properties": {
        "from_stage": {
          "type": "string",
          "enum": ["understand", "plan", "build", "verify", "deploy"]
        },
        "to_stage": {
          "type": "string",
          "enum": ["understand", "plan", "build", "verify", "deploy", "blocked"]
        },
        "skipped_stage": {
          "type": "string",
          "enum": ["understand", "plan", "build", "verify", "deploy"]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": ["string", "null"]
        },
        "learning_extracted": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["from_stage", "to_stage", "skipped_stage", "timestamp"]
    },
    "BypassRecord": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["wip_limit", "checklist_incomplete", "critical_skip", "qa_gate"]
        },
        "stage": {
          "type": "string",
          "enum": ["understand", "plan", "build", "verify", "deploy", "blocked"]
        },
        "reason": {
          "type": "string"
        },
        "authorized_by": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["type", "stage", "reason", "authorized_by", "timestamp"]
    }
  }
}
